---
/*
 * Monolito: una losa de piedra bajo una sola luz dura.
 * La luz sigue al cursor (o al dedo); en reposo se mueve sola, despacio,
 * como un sol. La cara iluminada y la sombra en el suelo cambian en
 * tiempo real. La lógica está en src/scripts/site.js (initMonolith).
 */
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
const id = `stone-${Math.random().toString(36).slice(2, 8)}`;
---
<div class:list={['mono-scene', cls]} data-monolith aria-hidden="true">
  <div class="mono-scene__floor"></div>
  <div class="mono-scene__shadow"></div>
  <div class="mono-scene__slab">
    <div class="mono-scene__face mono-scene__face--l"></div>
    <div class="mono-scene__face mono-scene__face--r"></div>
    <svg class="mono-scene__grain"><filter id={id}><feTurbulence type="fractalNoise" baseFrequency="0.85" numOctaves="4" stitchTiles="stitch" /><feColorMatrix type="saturate" values="0" /></filter><rect width="100%" height="100%" filter={`url(#${id})`} opacity="0.2" /></svg>
  </div>
  <div class="mono-scene__glow"></div>
  <div class="mono-scene__sun"></div>
</div>
